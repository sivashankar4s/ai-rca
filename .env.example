# AWS Credentials (leave blank to use IAM role / instance profile)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Athena Configuration
ATHENA_DATABASE=your_database_name
ATHENA_TABLE=monitoring_table
ATHENA_OUTPUT_BUCKET=s3://your-bucket/athena-query-results/

# CloudWatch Logs
CLOUDWATCH_LOG_GROUP=/your/application/log-group

# AWS Bedrock - Claude model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# CRM persistence (Postgres) - run `docker compose up -d` for local dev
DATABASE_URL=postgresql+psycopg2://airca:airca@localhost:5432/airca

# Provider selection (Strategy Pattern)
DATA_SOURCE_PROVIDER=athena          # athena
LLM_PROVIDER=navify                  # navify | openai
LOG_ANALYSIS_PROVIDER=cloudwatch     # cloudwatch | grafana_loki

# Grafana / Loki (only needed when LOG_ANALYSIS_PROVIDER=grafana_loki)
GRAFANA_LOKI_URL=https://your-grafana-host
GRAFANA_API_KEY=
GRAFANA_DATASOURCE_UID=your-loki-datasource-uid
