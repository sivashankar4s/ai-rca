# AWS Credentials (leave blank to use IAM role / instance profile)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Athena Configuration
ATHENA_DATABASE=your_database_name
ATHENA_TABLE=monitoring_table
ATHENA_OUTPUT_BUCKET=s3://your-bucket/athena-query-results/

# CloudWatch Logs
CLOUDWATCH_LOG_GROUP=/your/application/log-group

# CRM persistence (Postgres) - run `docker compose up -d` for local dev
DATABASE_URL=postgresql+psycopg2://airca:airca@localhost:5432/airca

# Provider selection (Strategy Pattern)
DATA_SOURCE_PROVIDER=athena          # athena | postgres
LLM_PROVIDER=anthropic               # anthropic | navify | openai
LOG_ANALYSIS_PROVIDER=cloudwatch     # cloudwatch | grafana_loki

# Anthropic Claude (direct API, used when LLM_PROVIDER=anthropic)
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Custom LLM (OpenAI-compatible, used when LLM_PROVIDER=navify|openai)
LLM_BASE_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=

# Grafana / Loki (only needed when LOG_ANALYSIS_PROVIDER=grafana_loki)
GRAFANA_LOKI_URL=https://your-grafana-host
GRAFANA_API_KEY=
GRAFANA_DATASOURCE_UID=your-loki-datasource-uid

# GitHub MCP (Code Analysis Agent / Source Code Intelligence) - surfaces recent
# commits/PRs/branches related to a failure.
# GITHUB_MCP_COMMAND is a full command line to launch the GitHub MCP server over stdio.
# Option A - binary on PATH (https://github.com/github/github-mcp-server/releases):
GITHUB_MCP_COMMAND=github-mcp-server stdio
# Option B - via Docker (requires Docker Desktop running):
# GITHUB_MCP_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
GITHUB_TOKEN=
GITHUB_REPO=owner/repo